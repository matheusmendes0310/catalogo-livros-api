          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "const livro = pm.response.json();",
              "pm.test(\"Dados cadastrados\", function () { pm.expect(livro.titulo).to.eql(\"Dom Casmurro\"); pm.expect(livro.id).to.be.a(\"number\"); });",
