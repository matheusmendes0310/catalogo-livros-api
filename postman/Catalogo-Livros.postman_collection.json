  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "idDom",
      "value": "",
      "type": "string"
    },
    {
      "key": "idMemorias",
      "value": "",
      "type": "string"
    },
    {
      "key": "idHobbit",
      "value": "",
      "type": "string"
    },
    {
      "key": "idNovo",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Listar catálogo vazio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/livros",
        "description": "01 - Listar catálogo vazio"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Lista vazia\", function () { pm.expect(pm.response.json()).to.eql([]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Cadastrar Dom Casmurro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/livros",
        "description": "02 - Cadastrar Dom Casmurro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Dom Casmurro\",\n  \"autor\": \"Machado de Assis\",\n  \"genero\": \"Romance\",\n  \"anoPublicacao\": 1899\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "const livro = pm.response.json();",
              "pm.test(\"Dados cadastrados\", function () { pm.expect(livro.titulo).to.eql(\"Dom Casmurro\"); pm.expect(livro.id).to.be.a(\"number\"); });",
              "pm.test(\"Localização do livro\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/livros/\" + livro.id); });",
              "pm.collectionVariables.set(\"idDom\", livro.id);"
            ]
          }
        }
      ]
    },
